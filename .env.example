# Mutual Fund FAQ Assistant - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Required: Groq API Key (Phase 4 RAG Pipeline)
# Get your API key from: https://console.groq.com/keys
# ============================================
GROQ_API_KEY=your_groq_api_key_here

# ============================================
# Optional: Configuration
# ============================================

# Groq Model Selection (default: llama-3.1-8b-instant)
# Options: llama-3.1-8b-instant, mixtral-8x7b-32768, llama-3.1-70b-versatile
GROQ_MODEL=llama-3.1-8b-instant

# Temperature for LLM generation (0.0-1.0, default: 0.1)
# Lower = more factual, Higher = more creative
LLM_TEMPERATURE=0.1

# Maximum tokens for LLM response (default: 500)
LLM_MAX_TOKENS=500

# ============================================
# Optional: OpenAI (Alternative to Groq)
# Uncomment and set if using OpenAI instead of Groq
# ============================================
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=text-embedding-3-small

# ============================================
# Development Settings
# ============================================

# Debug mode (True/False)
DEBUG=False

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
